# Logbook Bot Configuration
# Copy this file to .env and modify the values as needed

# Login credentials
EMAIL=your.email@binus.ac.id
PASSWORD=your_password

# Clock in and out times (12-hour format: HH:MM am or pm)
CLOCK_IN_TIME="08:00 am"
CLOCK_OUT_TIME="05:00 pm"

# Logbook month (use month abbreviation)
# EVEN semester months: FEB, MAR, APR, MAY, JUN, JUL, AUG
# ODD semester months: SEP, OCT, NOV, DEC, JAN, FEB
LOGBOOK_MONTH=SEP

# Internship semester (EVEN or ODD)
# EVEN: 2420, ODD: 2510
INTERNSHIP_SEMESTER=ODD

# Optional: exact semester code from the LMS dropdown (overrides INTERNSHIP_SEMESTER)
# The bot prints the available codes if the configured one is not found
SEMESTER_CODE=

# Excel file path
EXCEL_FILE_PATH=./src/data/monthly_activity.xlsx

# Dry run: true = only print what would be submitted, false = submit to the LMS
DRY_RUN=true

# Optional: only submit these dates (comma-separated YYYY-MM-DD), empty = all dates in the Excel file
ONLY_DATES=

# Run the browser without a window (required on a server)
HEADLESS=true

# Telegram bot (npm run telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional: OpenAI-compatible endpoint (e.g. 9router) to paraphrase logbook entries
LLM_BASE_URL=http://your-server:20128/v1
LLM_API_KEY=
LLM_MODEL=
